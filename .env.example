# Copy to .env on the server (never commit .env)
DOMAIN=habits.example.com
ACME_EMAIL=you@example.com

# Image published by the GitHub Actions workflow.
APP_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/habit-tracker:latest

POSTGRES_DB=habittracker
POSTGRES_USER=habit
POSTGRES_PASSWORD=replace-with-a-long-random-password

# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
JWT_EXPIRATION_MS=86400000

# Local timezone used for "today" when the browser does not send a date.
APP_TIMEZONE=UTC